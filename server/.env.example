# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=replace_with_database_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hermyx
DB_TEST_NAME=hermyx_test
DB_SSL=false

# Firebase Admin
# For local development, leave FIREBASE_JSON empty and provide the ignored
# src/config/firebase-service-account.json file instead.
FIREBASE_JSON=
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_API_KEY=replace_with_firebase_web_api_key
ADMIN_FIREBASE_UID=replace_with_admin_firebase_uid

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Scheduled jobs
CRON_SECRET_TOKEN=replace_with_a_random_secret

# Azure Blob Storage
# Leave empty to use local file storage during development.
AZURE_CONN_STRING=
